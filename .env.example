# Скопируйте значения в Render → Environment (файл .env сайт сам не читает)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
ADMIN_PIN=482913
# Пример при первом запуске (потом удалить):
# SEED_DEMO=1
# Если лимит бесплатного Neon 0,5 ГБ:
# STORAGE_LIMIT_MB=500
# Backblaze B2 (переключение и перенос файлов — автоматически при запуске):
# B2_KEY_ID=
# B2_KEY=
# B2_BUCKET=
